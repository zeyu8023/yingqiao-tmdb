# 在你已有的 HTTPS 网站 server {} 内使用；证书由 NAS / 反代面板管理。
# 将 192.168.31.10 替换为 NAS 的真实 IP，18012 替换为映桥的映射端口。
location / {
    proxy_pass http://192.168.31.10:18012;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    client_max_body_size 32k;
    # 加速地址包含访问密钥，API 查询也可能带 TMDB Key，不记录完整请求地址。
    access_log off;
}
